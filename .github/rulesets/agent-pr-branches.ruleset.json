{
  "name": "Agent PR branches",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/agent/pr/*",
        "refs/heads/copilot/pr/*",
        "refs/heads/pr/*"
